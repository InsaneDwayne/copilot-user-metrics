# Copy to .env (next to compose.yaml) and fill in.
# Generate secrets with:  python3 -c "import secrets; print(secrets.token_hex(32))"
# (hex keeps database passwords safe inside connection URLs)

# --- Image -------------------------------------------------------------------
# The release to run (see the GitHub Releases page). Empty = `latest`, the newest stable
# release, picked up by `docker compose pull`. The release bundle pins its own version;
# pinning is recommended in production so upgrades (and their migrations) are deliberate.
APP_VERSION=
# The stack `docker compose` runs without -f. Unset: compose.yaml (a one-shot `migrate`
# container). compose.worker-migrates.yaml: the worker migrates on start, one container fewer.
# COMPOSE_FILE=compose.worker-migrates.yaml

# --- GitHub ------------------------------------------------------------------
# The organization whose Copilot usage is shown (one org per deployment).
GITHUB_ORG=
# GitHub App (Settings > Developer settings > GitHub Apps), installed on GITHUB_ORG by an owner.
# Permissions (read-only): Administration, GitHub Copilot Business, Organization Copilot metrics, Members.
# Callback URL: PUBLIC_URL + /auth/github/callback (e.g. http://localhost:8000/auth/github/callback). No webhook needed.
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Private key of the App (only mounted into the worker).
GITHUB_APP_PRIVATE_KEY_FILE=./secrets/github-app.pem

# --- App ---------------------------------------------------------------------
# The URL people open in their browser (also the base of the OAuth callback). Expected: https,
# served by a TLS-terminating reverse proxy in front of the API (docs/deployment/docker-compose.md). An https URL
# gives the session cookie the Secure flag. http is accepted for localhost only, for trying
# the stack out on this machine; any other http URL needs ALLOW_HTTP=true.
PUBLIC_URL=http://localhost:8000
# Where the API is published on the host. 127.0.0.1 suits a proxy on the same host;
# use 0.0.0.0 when the proxy runs on another machine.
APP_BIND=127.0.0.1
APP_PORT=8000
# At least 32 characters (the API refuses to start otherwise).
SESSION_SECRET=
# Plain-HTTP mode: allow an http PUBLIC_URL other than localhost, e.g. on a test host. The
# session cookie and the OAuth code then cross the network unencrypted - never in production.
# ALLOW_HTTP=false

# --- Admin console access --------------------------------------------------
# Comma-separated team slugs of GITHUB_ORG (the part after /orgs/<org>/teams/ in the team's
# URL); members of child teams count too. Checked with GitHub at sign-in, so changes apply at
# the next sign-in (at the latest after SESSION_MAX_AGE_HOURS). Neither needs an org role.
# SECURITY: a slug only names a team. Whoever can add members to that team (its maintainers)
# grants the role, and if the team is renamed, deleted or misspelled here, anyone allowed to
# create teams in the org can create one with this slug and take the role. Check the slugs
# against existing teams, and in the org's member privileges turn off team creation by members.
# Admins: all org data plus the Sync page. Org owners are always admins; these teams add more.
# ACCESS_ADMIN_TEAMS=copilot-app-admins
# Organization readers: all org data, read only, no Sync page.
# ACCESS_ORG_READER_TEAMS=copilot-viewers

# --- Database (passwords: hex only) -----------------------------------------
# Superuser: only used inside the db container, to set up the roles below.
POSTGRES_PASSWORD=
# Owner role: runs the migrations and owns the tables.
OWNER_DB_PASSWORD=
# Read on every `docker compose up`, so changing one here changes the role's password.
API_DB_PASSWORD=
WORKER_DB_PASSWORD=

# --- Optional ----------------------------------------------------------------
# SESSION_MAX_AGE_HOURS=4
# SYNC_STALE_AFTER_HOURS=3
# SYNC_CREDITS_CRON=*/20 * * * *
# GitHub calls a credit sync makes at once.
# SYNC_PARALLEL_REQUESTS=8
# SYNC_SEATS_CRON=0 * * * *
# SYNC_METRICS_CRON=0 6 * * *
# SYNC_BUDGETS_CRON=10 * * * *
# On start, queue every day within GitHub's retention that isn't synced yet.
# SYNC_CATCH_UP_ON_START=true
# Sync runs, handled run/stop requests and finished queue jobs older than this are pruned
# daily (each job's latest success stays; synced usage data is never pruned).
# SYNC_HISTORY_RETENTION_DAYS=90
# SYNC_PRUNE_CRON=30 3 * * *
# A job failing this many times since its last success is logged as an error and marks the
# worker unhealthy until it succeeds again.
# SYNC_ALERT_AFTER_FAILURES=3
# FORWARDED_ALLOW_IPS=127.0.0.1
# LOG_LEVEL=INFO
