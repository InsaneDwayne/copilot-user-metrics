  "$defs": {
    "tokenValue": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        {
          "type": "string",
          "enum": [
            "canvas",
            "surface",
            "fg",
            "accent",
            "accent-100",
            "accent-200",
            "accent-300",
            "accent-400",
            "accent-500",
            "accent-600",
            "accent-700",
            "accent-800",
            "accent-900",
            "neutral-100",
            "neutral-200",
            "neutral-300",
            "neutral-400",
            "neutral-500",
            "neutral-600",
            "neutral-700",
            "neutral-800",
            "neutral-900"
          ]
        }
      ],
      "description": "A #rrggbb colour, or a palette token such as `accent-300`."
    }
  }
