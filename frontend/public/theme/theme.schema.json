            },
            "accent": {
              "description": "This mode's accent, used exactly as given. When omitted, `colors.accent` is used, darkened or lightened just enough to stay readable on `bg` (4.5:1 contrast).",
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "tokens": {
