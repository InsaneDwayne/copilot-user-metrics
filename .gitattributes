# Normalize line endings: LF in the repo and in working trees (containers are Linux).
* text=auto eol=lf

# Must stay LF or they break inside the container
*.sh   text eol=lf
Dockerfile text eol=lf

# Windows-only scripts
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary assets
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.otf  binary
*.pdf  binary

# Lockfiles: collapse in diffs, and don't try to merge them by hand
package-lock.json  linguist-generated=true -diff merge=binary
uv.lock            linguist-generated=true -diff merge=binary
