# Copy to .devcontainer/.env (gitignored) and fill in. Loaded into the app container.

# GitHub App used by the sync worker (installation token) and for user sign-in.
GITHUB_ORG=
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Path inside the container, e.g. /workspace/.secrets/github-app.pem (keep .secrets/ gitignored)
GITHUB_APP_PRIVATE_KEY_PATH=

# Session cookie signing key, at least 32 characters: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# --- Admin console access --------------------------------------------------
# Comma-separated team slugs of GITHUB_ORG (the part after /orgs/<org>/teams/ in the team's
# URL); members of child teams count too. Checked with GitHub at sign-in, so changes apply at
# the next sign-in (at the latest after SESSION_MAX_AGE_HOURS). Neither needs an org role.
# SECURITY: a slug only names a team. Whoever can add members to that team (its maintainers)
# grants the role, and if the team is renamed, deleted or misspelled here, anyone allowed to
# create teams in the org can create one with this slug and take the role. Check the slugs
# against existing teams, and in the org's member privileges turn off team creation by members.
# Admins: all org data plus the Sync page. Org owners are always admins; these teams add more.
# ACCESS_ADMIN_TEAMS=copilot-app-admins
# Organization readers: all org data, read only, no Sync page.
# ACCESS_ORG_READER_TEAMS=copilot-viewers

# --- Optional overrides (defaults shown) -------------------------------------
# Browser-facing base URL. In development that's Vite (it proxies /api and /auth),
# so register http://localhost:5173/auth/github/callback as the App's callback URL.
# https gives the session cookie the Secure flag; http is accepted for localhost only
# unless API_ALLOW_HTTP=true.
# API_PUBLIC_URL=http://localhost:5173
# API_ALLOW_HTTP=false
# API_STATIC_DIR=          # serve the built frontend from FastAPI (e.g. ../frontend/dist)
# SESSION_MAX_AGE_HOURS=4
# API_DOCS=false          # true serves the interactive API docs at /docs (development only)
# SYNC_CREDITS_CRON=*/20 * * * *
# GitHub calls a credit sync makes at once.
# SYNC_PARALLEL_REQUESTS=8
# SYNC_SEATS_CRON=0 * * * *
# SYNC_METRICS_CRON=0 6 * * *
# SYNC_BUDGETS_CRON=10 * * * *
# SYNC_CATCH_UP_ON_START=true
# Sync runs, handled run/stop requests and finished queue jobs older than this are pruned
# daily (each job's latest success stays; synced usage data is never pruned).
# SYNC_HISTORY_RETENTION_DAYS=90
# SYNC_PRUNE_CRON=30 3 * * *
# A job failing this many times since its last success is logged as an error and marks the
# worker unhealthy until it succeeds again.
# SYNC_ALERT_AFTER_FAILURES=3
# SYNC_STALE_AFTER_HOURS=3
# GITHUB_API_VERSION=2026-03-10
# LOG_LEVEL=INFO
